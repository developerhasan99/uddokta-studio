---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import DashboardMock from "../components/DashboardMock.astro";
import { SIGNUP_URL, WHATSAPP_URL } from "../site";

const facts = [
  "পুরো ড্যাশবোর্ড বাংলায়",
  "ক্যাশ অন ডেলিভারির জন্য বানানো",
  "Steadfast কুরিয়ার যুক্ত",
  "Meta ও TikTok পিক্সেল",
];

const steps = [
  { title: "পণ্য যোগ করুন", body: "ছবি, দাম, সাইজ-রঙের ভ্যারিয়েন্ট আর স্টক। একবার ছবি আপলোড করলে সব পেজে ব্যবহার করা যায়।" },
  { title: "ল্যান্ডিং পেজ বানান", body: "তৈরি লেআউট বেছে নিন, সেকশন সাজান, প্রকাশ করুন। লিংকটি ফেসবুক বিজ্ঞাপনে বসিয়ে দিন।" },
  { title: "অর্ডার আসুক", body: "ক্রেতা নাম, মোবাইল আর ঠিকানা দিয়ে অর্ডার করেন। দাম আর ডেলিভারি চার্জ সিস্টেম নিজেই হিসাব করে।" },
  { title: "নিশ্চিত করে পাঠান", body: "ফোনে নিশ্চিত করুন, এক ক্লিকে কুরিয়ার বুক করুন। ডেলিভারি হলে আসল লাভ দেখুন।" },
];

const tools = [
  { title: "স্টক ও ওয়্যারহাউস", body: "সব পণ্যের স্টক এক তালিকায়, স্প্রেডশিটের মতো এডিট করুন। একাধিক গুদামের হিসাব আলাদা রাখুন।" },
  { title: "কুপন ও ডিসকাউন্ট", body: "কুপন কোড দিয়ে ছাড় দিন, কতবার ব্যবহার হবে তা ঠিক করে দিন।" },
  { title: "রিপিট সেল", body: "যাদের অর্ডার ডেলিভারি হয়েছে কিন্তু আর কেনেননি, তাদের ফোন করার তালিকা নিজে থেকেই তৈরি হয়।" },
  { title: "লাভের হিসাব", body: "ডেলিভারি হওয়া অর্ডার থেকে কেনা দাম বাদ দিয়ে আসল লাভ। শুধু মালিক আর অ্যাডমিন দেখতে পান।" },
  { title: "মিডিয়া গ্যালারি", body: "ছবি আপলোডের সময় নিজে থেকে ছোট হয়। কোন ছবি কোথায় ব্যবহার হচ্ছে দেখা যায়।" },
  { title: "টিম ও অনুমতি", body: "হোয়াটসঅ্যাপে আমন্ত্রণ লিংক পাঠিয়ে স্টাফ যোগ করুন। স্টাফ কেনা দাম দেখতে পান না।" },
  { title: "অনলাইন স্টোর", body: "ল্যান্ডিং পেজের পাশাপাশি পুরো দোকান: কালেকশন, মেনু আর এক ক্লিকে স্টাইল বদল।" },
  { title: "নিজের ডোমেইন", body: "শুরুতে আপনার দোকানের ঠিকানা yourshop.uddokta.live। চাইলে নিজের ডোমেইনও যুক্ত করুন।" },
  { title: "পিক্সেল ও ট্র্যাকিং", body: "Meta আর TikTok পিক্সেল আইডি বসিয়ে দিন, বিজ্ঞাপন থেকে কতটা বিক্রি আসছে বুঝুন।" },
];

const soon = [
  { title: "ইনবক্স", body: "ফেসবুক পেজের সব মেসেজ এক জায়গায়।" },
  { title: "AI সেলসম্যান", body: "সাধারণ প্রশ্নের উত্তর আর অর্ডার নেওয়ায় সাহায্য।" },
  { title: "SMS", body: "অর্ডার নিশ্চিত আর ডেলিভারির খবর ক্রেতার ফোনে।" },
  { title: "অনলাইন পেমেন্ট", body: "ক্যাশ অন ডেলিভারির পাশাপাশি অগ্রিম পেমেন্ট।" },
  { title: "Pathao কুরিয়ার", body: "Steadfast-এর পর আরও কুরিয়ার।" },
  { title: "কাস্টমার সেগমেন্ট", body: "কেনার ধরন অনুযায়ী কাস্টমার ভাগ করুন।" },
];

const faqs = [
  { q: "উদ্যোক্তা স্টুডিও কাদের জন্য?", a: "যারা ফেসবুক বা অন্য সোশ্যাল মিডিয়ায় বিজ্ঞাপন দিয়ে ক্যাশ অন ডেলিভারিতে পণ্য বিক্রি করেন। একজন একা দোকান চালালেও চলবে, ছোট টিম থাকলেও।" },
  { q: "ওয়েবসাইট বানাতে কোডিং জানা লাগবে?", a: "না। তৈরি লেআউট থেকে শুরু করে সেকশন টেনে সাজাতে পারবেন, পাশেই দেখবেন ফোনে পেজটি কেমন দেখাবে। সব কাজ বাংলায়।" },
  { q: "ভুয়া অর্ডার কীভাবে আটকায়?", a: "যে নম্বর বারবার অর্ডার করে পার্সেল নেয় না, সেটি ব্লক করে দিন, সেই নম্বর থেকে পেজে আর অর্ডার আসবে না। এক নম্বর থেকে এক ঘণ্টায় পাঁচটির বেশি অর্ডার নেওয়া হয় না, আর একই পণ্য ২৪ ঘণ্টার মধ্যে আবার অর্ডার হলে আলাদা চিহ্ন দেখায়।" },
  { q: "কোন কুরিয়ারের সাথে কাজ করে?", a: "এখন Steadfast। আপনার Steadfast অ্যাকাউন্ট যুক্ত করলে অর্ডার পেজ থেকেই বুক করতে পারবেন। Pathao আসছে।" },
  { q: "নিজের ডোমেইন ব্যবহার করা যাবে?", a: "হ্যাঁ। শুরুতে আপনার দোকান yourshop.uddokta.live ঠিকানায় থাকে। সেটিংসের ডোমেইন থেকে নিজের ডোমেইন যুক্ত করতে পারবেন।" },
  { q: "আমার দোকানের তথ্য কতটা নিরাপদ?", a: "প্রতিটি দোকানের তথ্য ডেটাবেসের স্তরেই আলাদা রাখা হয়, এক দোকান অন্যটির তথ্য দেখতে পারে না। কুরিয়ারের লগইন এনক্রিপ্ট করে রাখা হয়, আর কেনা দাম স্টাফদের কাছে লুকানো থাকে।" },
  { q: "খরচ কত?", a: "এখন যে কেউ অ্যাকাউন্ট খুলে ব্যবহার শুরু করতে পারেন। প্ল্যান আর দামের বিস্তারিত বিলিং চালু হওয়ার আগে জানিয়ে দেওয়া হবে।" },
];

const bn = (n: number) => n.toLocaleString("bn-BD");
---

<Layout title="উদ্যোক্তা স্টুডিও | ফেসবুক সেলারদের জন্য ল্যান্ডিং পেজ, অর্ডার আর কুরিয়ার">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="section pt-14 sm:pt-20 text-center">
      <p class="eyebrow justify-center">ফেসবুক আর ক্যাশ অন ডেলিভারি সেলারদের জন্য</p>
      <h1 class="mt-4 mx-auto max-w-4xl text-[32px] sm:text-[54px] leading-[1.2] font-bold tracking-tight text-ink">
        ল্যান্ডিং পেজ থেকে ডেলিভারি,<br class="hidden sm:block" /> পুরো ব্যবসা <span class="text-primary">এক জায়গায়।</span>
      </h1>
      <p class="mt-5 mx-auto max-w-2xl text-[15px] sm:text-[17px] text-muted leading-relaxed">
        কয়েক মিনিটে পণ্যের ল্যান্ডিং পেজ বানান, অর্ডার নিন, ভুয়া অর্ডার আটকান আর এক ক্লিকে কুরিয়ার বুক করুন। বাংলাদেশের অনলাইন সেলারদের জন্য বাংলায় বানানো।
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={SIGNUP_URL} class="btn btn-primary">অ্যাকাউন্ট খুলুন <Icon name="arrow" size={16} /></a>
        <a href="#how" class="btn">কীভাবে কাজ করে</a>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-[13px] text-ink-2">
        {facts.map((f) => <li class="inline-flex items-center gap-1.5"><Icon name="check" size={15} class="text-primary" />{f}</li>)}
      </ul>
    </div>
    <div class="relative mt-12 sm:mt-16">
      <div class="absolute inset-x-0 bottom-0 top-1/3 bg-paper-2 border-t border-rule"></div>
      <div class="section relative pb-14 sm:pb-20">
        <DashboardMock />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="py-16 sm:py-24">
    <div class="section">
      <p class="eyebrow">কীভাবে কাজ করে</p>
      <h2 class="section-title mt-2">বিজ্ঞাপন থেকে টাকা হাতে আসা পর্যন্ত চার ধাপ</h2>
      <p class="section-lead">আলাদা আলাদা অ্যাপ, শিট আর খাতার দরকার নেই। প্রতিটি ধাপ একই ড্যাশবোর্ডে।</p>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="card p-5">
            <span class="inline-flex w-8 h-8 items-center justify-center rounded-control bg-primary text-white text-sm font-bold">{bn(i + 1)}</span>
            <h3 class="mt-4 text-[17px] font-semibold text-ink">{s.title}</h3>
            <p class="mt-2 text-sm text-muted leading-relaxed">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Feature spotlights -->
  <section id="features" class="py-16 sm:py-24 bg-paper-2 border-y border-rule">
    <div class="section">
      <p class="eyebrow">ফিচার</p>
      <h2 class="section-title mt-2">একটি পণ্য বিক্রির জন্য যা যা লাগে</h2>
      <p class="section-lead">এখন আমাদের মূল নজর ল্যান্ডিং পেজ দিয়ে ক্যাশ অন ডেলিভারি বিক্রিতে, তাই এই অংশগুলো সবচেয়ে গোছানো।</p>

      <!-- Landing pages -->
      <div class="mt-12 grid gap-10 lg:grid-cols-2 items-center">
        <div>
          <h3 class="text-[22px] sm:text-[26px] font-bold text-ink leading-snug">অর্ডার ফর্মসহ ল্যান্ডিং পেজ</h3>
          <p class="mt-3 text-muted leading-relaxed">একটি পণ্যের জন্য এক পাতার পেজ, যা ফোনে দ্রুত খোলে আর সরাসরি অর্ডার নেয়। বিজ্ঞাপনের লিংক এখানেই দিন।</p>
          <ul class="mt-5 space-y-2.5 text-[14px] text-ink-2">
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />খালি পাতা, অথবা পণ্যের নাম আর ছবি বসানো তৈরি লেআউট থেকে শুরু করুন</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />সেকশন যোগ করুন, টেনে সাজান, পাশেই লাইভ প্রিভিউ</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />খসড়া সেভ হয়, লাইভ পেজ বদলায় শুধু প্রকাশ করলে</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />এক ক্লিকে পেজের কপি বানিয়ে নতুন অফার পরীক্ষা করুন</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />ঢাকার ভেতরে আর বাইরের ডেলিভারি চার্জ নিজে থেকে যোগ হয়</li>
          </ul>
        </div>
        <div class="flex justify-center" role="img" aria-label="ফোনে একটি ল্যান্ডিং পেজ, অর্ডার ফর্মসহ, নমুনা">
          <div class="w-[280px] rounded-[34px] bg-frame p-2.5 shadow-[0_24px_50px_-20px_oklch(0%_0_0/0.45)]" aria-hidden="true">
            <div class="rounded-[26px] bg-paper overflow-hidden">
              <div class="h-[150px] bg-paper-3 flex items-center justify-center text-muted"><Icon name="image" size={36} /></div>
              <div class="p-4">
                <div class="flex items-center justify-between">
                  <span class="badge badge-plain">নমুনা</span>
                  <span class="text-[12px] text-muted line-through">৳২,২০০</span>
                </div>
                <div class="mt-2 text-[16px] font-bold text-ink leading-snug">কটন থ্রি-পিস, হাতের কাজ</div>
                <div class="text-[20px] font-bold text-primary">৳১,৮৫০</div>
                <div class="mt-3 space-y-2">
                  <div class="field">আপনার নাম</div>
                  <div class="field">মোবাইল নম্বর</div>
                  <div class="field">পুরো ঠিকানা</div>
                  <div class="grid grid-cols-2 gap-2">
                    <div class="field !border-primary text-ink">ঢাকার ভেতরে</div>
                    <div class="field">ঢাকার বাইরে</div>
                  </div>
                </div>
                <div class="mt-3 flex justify-between text-[12.5px]"><span class="text-muted">মোট</span><span class="font-bold text-ink">৳১,৯২০</span></div>
                <div class="mt-2 h-9 rounded-control bg-primary text-white text-[13px] font-semibold flex items-center justify-center" style="box-shadow: var(--shadow-btn-fill)">অর্ডার করুন</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Orders -->
      <div class="mt-20 grid gap-10 lg:grid-cols-2 items-center">
        <div class="lg:order-2">
          <h3 class="text-[22px] sm:text-[26px] font-bold text-ink leading-snug">নতুন থেকে ডেলিভারি পর্যন্ত সব অর্ডার</h3>
          <p class="mt-3 text-muted leading-relaxed">পেজ থেকে আসা আর ফোনে নেওয়া অর্ডার একই তালিকায়। প্রতিটি অর্ডার কোন ধাপে আছে, এক নজরে দেখুন।</p>
          <ul class="mt-5 space-y-2.5 text-[14px] text-ink-2">
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />অর্ডারের সাথে সাথে স্টক কমে, বাতিল বা ফেরত হলে ফিরে আসে</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />Steadfast-এ এক ক্লিকে বুকিং, দুবার চাপলেও দুবার বুক হয় না</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />নাম, নম্বর, তারিখ দিয়ে খুঁজুন; পছন্দের ফিল্টার সেভ করে রাখুন</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />ট্যাগ, নোট আর কে কখন কী বদলেছেন তার হিসাব</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />দরকার হলে সব অর্ডার CSV ফাইলে নামিয়ে নিন</li>
          </ul>
        </div>
        <div class="lg:order-1 card p-4 sm:p-5" role="img" aria-label="অর্ডারের ধাপ আর একটি অর্ডারের বিবরণ, নমুনা">
          <div aria-hidden="true">
            <div class="flex items-center justify-between">
              <div class="text-[14px] font-semibold">অর্ডারের অবস্থা</div>
              <span class="badge badge-plain">নমুনা</span>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-1.5">
              <span class="badge badge-new">নতুন</span><Icon name="arrow" size={13} class="text-muted" />
              <span class="badge badge-ok">নিশ্চিত</span><Icon name="arrow" size={13} class="text-muted" />
              <span class="badge badge-plain">প্যাক করা</span><Icon name="arrow" size={13} class="text-muted" />
              <span class="badge badge-warn">কুরিয়ারে</span><Icon name="arrow" size={13} class="text-muted" />
              <span class="badge badge-ok">ডেলিভারি হয়েছে</span>
            </div>
            <div class="mt-5 rounded-card border border-rule">
              <div class="flex items-center justify-between px-4 h-11 border-b border-rule">
                <div class="text-[13px] font-semibold">অর্ডার #১০৪১</div>
                <span class="badge badge-ok">নিশ্চিত</span>
              </div>
              <div class="px-4 py-3 text-[13px] space-y-2">
                <div class="flex justify-between"><span class="text-muted">লেদার ওয়ালেট × ১</span><span>৳৯৯০</span></div>
                <div class="flex justify-between"><span class="text-muted">ডেলিভারি, ঢাকার ভেতরে</span><span>৳৭০</span></div>
                <div class="flex justify-between font-semibold border-t border-rule pt-2"><span>ক্রেতার কাছ থেকে নেবেন</span><span>৳১,০৬০</span></div>
              </div>
              <div class="flex flex-wrap gap-2 px-4 pb-4">
                <span class="btn btn-sm btn-primary pointer-events-none"><Icon name="truck" size={15} /> কুরিয়ারে বুক করুন</span>
                <span class="btn btn-sm pointer-events-none">প্যাক হয়েছে</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Protection and incomplete orders -->
      <div class="mt-20 grid gap-10 lg:grid-cols-2 items-center">
        <div>
          <h3 class="text-[22px] sm:text-[26px] font-bold text-ink leading-snug">ভুয়া অর্ডার কমান, হারানো অর্ডার ফেরান</h3>
          <p class="mt-3 text-muted leading-relaxed">ক্যাশ অন ডেলিভারিতে বড় ক্ষতি হয় ফেরত আসা পার্সেলে। কে আসল ক্রেতা, তা অর্ডারের সময়েই বোঝার ব্যবস্থা।</p>
          <ul class="mt-5 space-y-2.5 text-[14px] text-ink-2">
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />সমস্যার নম্বর ব্লক করুন, সেই নম্বর থেকে পেজে আর অর্ডার আসবে না</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />এক নম্বর থেকে ঘণ্টায় পাঁচটির বেশি অর্ডার নয়, সাথে বট আটকানোর ব্যবস্থা</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />২৪ ঘণ্টার মধ্যে একই পণ্যের দ্বিতীয় অর্ডারে আলাদা চিহ্ন</li>
            <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />ফোন নম্বর দিয়েও যারা অর্ডার শেষ করেননি, তাদের তালিকা; ফোন করে অর্ডার ফিরিয়ে আনুন</li>
          </ul>
        </div>
        <div class="card overflow-hidden" role="img" aria-label="অসম্পূর্ণ অর্ডারের তালিকা, নমুনা">
          <div aria-hidden="true">
            <div class="flex items-center justify-between px-4 h-12 border-b border-rule">
              <div class="text-[14px] font-semibold">অসম্পূর্ণ অর্ডার</div>
              <span class="badge badge-plain">নমুনা</span>
            </div>
            {[
              { name: "মাহমুদা আক্তার", item: "হিজাব সেট", when: "১২ মিনিট আগে" },
              { name: "আরিফ হোসেন", item: "স্মার্ট ওয়াচ", when: "১ ঘণ্টা আগে" },
              { name: "শারমিন নাহার", item: "কটন থ্রি-পিস", when: "৩ ঘণ্টা আগে" },
            ].map((r) => (
              <div class="flex items-center gap-3 px-4 h-14 border-b border-rule">
                <div class="min-w-0 flex-1">
                  <div class="text-[13px] font-medium text-ink truncate">{r.name}</div>
                  <div class="text-[12px] text-muted truncate">{r.item} · {r.when}</div>
                </div>
                <span class="btn btn-sm pointer-events-none"><Icon name="phone" size={14} /> ফোন করুন</span>
              </div>
            ))}
            <div class="flex items-center gap-3 px-4 py-3 bg-error-soft">
              <Icon name="shield" class="text-error shrink-0" />
              <div class="text-[12.5px] text-ink-2">একটি নম্বর ব্লক করা আছে: আগের ৩টি পার্সেল নেননি</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- More tools -->
  <section class="py-16 sm:py-24">
    <div class="section">
      <p class="eyebrow">আরও যা আছে</p>
      <h2 class="section-title mt-2">দোকান চালানোর বাকি কাজও এখানেই</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((t) => (
          <div class="card p-5">
            <h3 class="text-[16px] font-semibold text-ink">{t.title}</h3>
            <p class="mt-1.5 text-sm text-muted leading-relaxed">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Built for Bangladesh -->
  <section class="pb-16 sm:pb-24">
    <div class="section">
      <div class="rounded-panel bg-frame text-frame-ink p-6 sm:p-10 grid gap-8 lg:grid-cols-2">
        <div>
          <p class="text-[13px] font-semibold text-frame-active">বাংলাদেশের জন্য বানানো</p>
          <h2 class="mt-2 text-[24px] sm:text-[32px] font-bold leading-snug">বিদেশি সফটওয়্যার মানিয়ে নেওয়া নয়, শুরু থেকেই এখানকার বিক্রির ধরনে</h2>
          <p class="mt-3 text-frame-muted leading-relaxed">বেশিরভাগ বিদেশি প্ল্যাটফর্ম বানানো কার্ড পেমেন্টের জন্য। এখানে বিক্রি হয় ফেসবুক বিজ্ঞাপন, ফোনে নিশ্চিত করা আর ক্যাশ অন ডেলিভারিতে। উদ্যোক্তা স্টুডিও সেই পথ ধরেই সাজানো।</p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 self-center">
          {[
            ["বাংলা আগে", "প্রতিটি লেখা আর বোতাম আগে বাংলায়। চাইলে ইংরেজিতেও ব্যবহার করা যায়।"],
            ["টাকায় সঠিক হিসাব", "দাম, ডেলিভারি চার্জ আর কুপন সিস্টেম নিজে হিসাব করে, হাতে যোগ-বিয়োগের ভুল নেই।"],
            ["ফোনেই চলে", "ড্যাশবোর্ড আর দোকান দুটোই ফোনের জন্য গোছানো।"],
            ["তথ্য আলাদা ও সুরক্ষিত", "প্রতিটি দোকানের তথ্য ডেটাবেসেই আলাদা, কুরিয়ারের লগইন এনক্রিপ্ট করা।"],
          ].map(([t, b]) => (
            <li class="rounded-card border border-frame-rule p-4">
              <div class="flex items-center gap-2 font-semibold text-[15px]"><Icon name="check" size={16} class="text-frame-active" />{t}</div>
              <p class="mt-1.5 text-[13px] text-frame-muted leading-relaxed">{b}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Coming soon -->
  <section class="pb-16 sm:pb-24">
    <div class="section">
      <p class="eyebrow">সামনে যা আসছে</p>
