---
import Layout from "../layouts/Layout.astro";
---

<Layout title="পাতাটি পাওয়া যায়নি | উদ্যোক্তা">
  <section class="section py-24 sm:py-32 text-center">
    <p class="eyebrow justify-center">৪০৪</p>
    <h1 class="mt-3 text-[28px] sm:text-[40px] font-bold tracking-tight text-ink">এই পাতাটি খুঁজে পাওয়া যায়নি</h1>
    <p class="section-lead mx-auto">লিংকটি হয়তো ভুল, অথবা পাতাটি সরিয়ে ফেলা হয়েছে। হোমপেজ থেকে আবার শুরু করুন।</p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="btn btn-primary">হোমপেজে যান</a>
      <a href="/blog" class="btn">ব্লগ পড়ুন</a>
    </div>
  </section>
</Layout>
