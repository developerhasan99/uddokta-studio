      { q: "ভুয়া অর্ডার কীভাবে আটকায়?", a: "যে নম্বর বারবার অর্ডার করে পার্সেল নেয় না, সেটি ব্লক করে দিন, সেই নম্বর থেকে পেজে আর অর্ডার আসবে না। এক নম্বর থেকে এক ঘণ্টায় পাঁচটির বেশি অর্ডার নেওয়া হয় না, আর একই পণ্য ২৪ ঘণ্টার মধ্যে আবার অর্ডার হলে আলাদা চিহ্ন দেখায়।" },
      { q: "কোন কুরিয়ারের সাথে কাজ করে?", a: "এখন Steadfast। আপনার Steadfast অ্যাকাউন্ট যুক্ত করলে অর্ডার পেজ থেকেই বুক করতে পারবেন। Pathao আসছে।" },
      { q: "নিজের ডোমেইন ব্যবহার করা যাবে?", a: "হ্যাঁ। শুরুতে আপনার দোকান yourshop.uddokta.live ঠিকানায় থাকে। সেটিংসের ডোমেইন থেকে নিজের ডোমেইন যুক্ত করতে পারবেন।" },
      { q: "আমার দোকানের তথ্য কতটা নিরাপদ?", a: "প্রতিটি দোকানের তথ্য ডেটাবেসের স্তরেই আলাদা রাখা হয়, এক দোকান অন্যটির তথ্য দেখতে পারে না। কুরিয়ারের লগইন এনক্রিপ্ট করে রাখা হয়, আর কেনা দাম স্টাফদের কাছে লুকানো থাকে।" },
      { q: "খরচ কত?", a: "এখন যে কেউ অ্যাকাউন্ট খুলে ব্যবহার শুরু করতে পারেন। প্ল্যান আর দামের বিস্তারিত বিলিং চালু হওয়ার আগে জানিয়ে দেওয়া হবে।" },
    ],
    ctaTitle: "আজই প্রথম ল্যান্ডিং পেজ চালু করুন",
    ctaLead: "অ্যাকাউন্ট খুলুন, দোকানের নাম দিন, একটি পণ্য যোগ করুন। তারপর তৈরি লেআউট থেকে প্রথম পেজ।",
    ctaWhatsapp: "হোয়াটসঅ্যাপে কথা বলুন",
  },
  en: {
    title: `${BRAND.en} | Landing pages, orders and couriers for Facebook sellers`,
    facts: ["Full dashboard in Bangla", "Built for cash on delivery", "Steadfast courier connected", "Meta and TikTok pixels"],
    heroEyebrow: "For Facebook and cash-on-delivery sellers",
    heroA: "From landing page to delivery,", heroB: "your whole business", heroC: "in one place.",
    heroLead: "Build a product landing page in minutes, take orders, stop fake orders and book a courier in one click. Made for online sellers in Bangladesh.",
    signup: "Sign up", how: "How it works",
    howTitle: "Four steps from ad to cash in hand",
    howLead: "No more separate apps, sheets and notebooks. Every step lives in the same dashboard.",
    steps: [
      { title: "Add products", body: "Photos, prices, size and colour variants, and stock. Upload a photo once and use it on every page." },
      { title: "Build a landing page", body: "Pick a ready-made layout, arrange the sections, publish. Then drop the link into your Facebook ad." },
      { title: "Orders come in", body: "Buyers order with their name, phone and address. The system works out the price and delivery charge." },
      { title: "Confirm and ship", body: "Confirm by phone, book the courier in one click. See your real profit once it's delivered." },
    ],
    featuresEyebrow: "Features",
    featuresTitle: "Everything it takes to sell one product",
    featuresLead: "Our main focus right now is cash-on-delivery selling through landing pages, so these parts are the most polished.",
    sample: "Sample",
    lp: {
      title: "Landing pages with an order form",
      body: "A one-page site for a single product that opens fast on phones and takes orders directly. Point your ad link here.",
      points: [
        "Start from a blank page, or a ready layout with the product name and photos filled in",
        "Add sections, drag to reorder, with a live preview alongside",
        "Drafts are saved; the live page changes only when you publish",
        "Duplicate a page in one click to test a new offer",
        "Delivery charges inside and outside Dhaka are added automatically",
      ],
      label: "A landing page with an order form on a phone, sample",
      oldPrice: "৳2,200", product: "Cotton three-piece, hand-embroidered", price: "৳1,850",
      fields: ["Your name", "Mobile number", "Full address"], inside: "Inside Dhaka", outside: "Outside Dhaka",
      total: "Total", totalValue: "৳1,920", order: "Place order",
    },
    orders: {
      title: "Every order, from new to delivered",
      body: "Orders from your pages and orders taken by phone sit in one list. See which stage each order is at, at a glance.",
      points: [
        "Stock goes down with each order and comes back on cancellation or return",
        "One-click Steadfast booking; a double click never books twice",
        "Search by name, number or date, and save the filters you use",
        "Tags, notes and a record of who changed what, and when",
        "Download all your orders as a CSV file when you need to",
      ],
      label: "Order stages and one order's details, sample",
      status: "Order status",
      flow: ["New", "Confirmed", "Packed", "With courier", "Delivered"],
      no: "Order #1041", confirmed: "Confirmed",
      item: "Leather wallet × 1", itemPrice: "৳990", delivery: "Delivery, inside Dhaka", deliveryPrice: "৳70",
      collect: "Collect from buyer", collectValue: "৳1,060",
      book: "Book courier", packed: "Mark packed",
    },
    protect: {
      title: "Cut fake orders, win back lost ones",
      body: "With cash on delivery, returned parcels cost the most. Spot who's a real buyer at the moment they order.",
      points: [
        "Block problem numbers so they can't order from your pages again",
        "No more than five orders an hour from one number, plus bot protection",
        "A second order for the same product within 24 hours gets flagged",
        "A list of people who entered their phone but didn't finish ordering; call them and recover the sale",
      ],
      label: "List of incomplete orders, sample",
      listTitle: "Incomplete orders",
      rows: [
        { name: "Mahmuda Akter", item: "Hijab set", when: "12 minutes ago" },
        { name: "Arif Hossain", item: "Smart watch", when: "1 hour ago" },
        { name: "Sharmin Nahar", item: "Cotton three-piece", when: "3 hours ago" },
      ],
      call: "Call", blocked: "One number is blocked: refused the last 3 parcels",
    },
    moreEyebrow: "And more",
    moreTitle: "The rest of running a shop, here too",
    tools: [
      { title: "Stock and warehouses", body: "Stock for every product in one list, editable like a spreadsheet. Keep separate counts for each warehouse." },
      { title: "Coupons and discounts", body: "Offer discounts with coupon codes and set how many times each can be used." },
      { title: "Repeat sales", body: "A call list of customers whose orders were delivered but haven't bought again, built automatically." },
      { title: "Profit tracking", body: "Real profit from delivered orders, after cost price. Only owners and admins can see it." },
      { title: "Media gallery", body: "Photos are resized automatically on upload. See where each photo is being used." },
      { title: "Team and permissions", body: "Add staff by sending an invite link on WhatsApp. Staff can't see cost prices." },
      { title: "Online store", body: "A full shop alongside your landing pages: collections, menus and one-click style changes." },
      { title: "Your own domain", body: "Your shop starts at yourshop.uddokta.live. Connect your own domain whenever you like." },
      { title: "Pixels and tracking", body: "Add your Meta and TikTok pixel IDs and see how many sales your ads bring in." },
    ],
    bd: {
      eyebrow: "Made for Bangladesh",
      title: "Not foreign software adapted, but built for how selling works here",
      body: `Most foreign platforms are built for card payments. Here, sales happen through Facebook ads, phone confirmation and cash on delivery. ${BRAND.en} is built around exactly that.`,
      points: [
        ["Bangla first", "Every label and button is in Bangla first. English is there if you prefer it."],
        ["Accurate taka totals", "Prices, delivery charges and coupons are calculated for you, with no manual arithmetic errors."],
        ["Works on your phone", "Both the dashboard and the shop are designed for phones."],
        ["Separate, secure data", "Each shop's data is isolated in the database, and courier logins are encrypted."],
      ],
    },
    soonEyebrow: "Coming soon",
    soonTitle: "What we're working on now",
    soonLead: "These appear in the dashboard marked \"Coming soon\". When they launch, there's nothing extra to install.",
    soonBadge: "Soon",
    soon: [
      { title: "Inbox", body: "All your Facebook page messages in one place." },
      { title: "AI salesperson", body: "Answers common questions and helps take orders." },
      { title: "SMS", body: "Order confirmations and delivery updates on the buyer's phone." },
      { title: "Online payments", body: "Advance payments alongside cash on delivery." },
      { title: "Pathao courier", body: "More couriers after Steadfast." },
      { title: "Customer segments", body: "Group customers by how they buy." },
    ],
    faqEyebrow: "FAQ",
    faqTitle: "What sellers ask most",
    faqLeadA: "Can't find an answer? Ask us on ", faqLeadLink: "WhatsApp", faqLeadB: ".",
    faqs: [
      { q: `Who is ${BRAND.en} for?`, a: "Anyone who sells with cash on delivery through ads on Facebook or other social media. It works whether you run the shop alone or with a small team." },
      { q: "Do I need to know how to code?", a: "No. Start from a ready-made layout and drag sections into place, with a preview of how the page looks on a phone right next to it. Everything is in Bangla." },
      { q: "How does it stop fake orders?", a: "Block numbers that keep ordering and refusing parcels, and they can't order from your pages again. No more than five orders an hour are accepted from one number, and a repeat order for the same product within 24 hours is flagged." },
      { q: "Which couriers does it work with?", a: "Steadfast for now. Connect your Steadfast account and book straight from the orders page. Pathao is coming." },
      { q: "Can I use my own domain?", a: "Yes. Your shop starts at yourshop.uddokta.live. Connect your own domain from Settings → Domains." },
      { q: "How safe is my shop's data?", a: "Each shop's data is kept separate at the database level, so no shop can see another's. Courier logins are stored encrypted, and cost prices are hidden from staff." },
      { q: "How much does it cost?", a: "Anyone can sign up and start using it now. Plan and pricing details will be announced before billing starts." },
    ],
    ctaTitle: "Launch your first landing page today",
    ctaLead: "Sign up, name your shop, add a product. Then build your first page from a ready-made layout.",
    ctaWhatsapp: "Chat on WhatsApp",
  },
};
const t = copy[lang];
const num = (n: number) => n.toLocaleString(lang === "en" ? "en-US" : "bn-BD");
const flowCls = ["badge-new", "badge-ok", "badge-plain", "badge-warn", "badge-ok"];
---

<Layout title={t.title} lang={lang} alternates={{ bn: "/", en: "/en/" }}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="section pt-14 sm:pt-20 text-center">
      <p class="eyebrow justify-center">{t.heroEyebrow}</p>
      <h1 class="mt-4 mx-auto max-w-4xl text-[32px] sm:text-[54px] leading-[1.2] font-bold tracking-tight text-ink">
        {t.heroA}<br class="hidden sm:block" /> {t.heroB} <span class="text-primary">{t.heroC}</span>
      </h1>
      <p class="mt-5 mx-auto max-w-2xl text-[15px] sm:text-[17px] text-muted leading-relaxed">{t.heroLead}</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={SIGNUP_URL} class="btn btn-primary">{t.signup} <Icon name="arrow" size={16} /></a>
        <a href="#how" class="btn">{t.how}</a>
      </div>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-[13px] text-ink-2">
        {t.facts.map((f) => <li class="inline-flex items-center gap-1.5"><Icon name="check" size={15} class="text-primary" />{f}</li>)}
      </ul>
    </div>
    <div class="relative mt-12 sm:mt-16">
      <div class="absolute inset-x-0 bottom-0 top-1/3 bg-paper-2 border-t border-rule"></div>
      <div class="section relative pb-14 sm:pb-20">
        <DashboardMock lang={lang} />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="py-16 sm:py-24">
    <div class="section">
      <p class="eyebrow">{t.how}</p>
      <h2 class="section-title mt-2">{t.howTitle}</h2>
      <p class="section-lead">{t.howLead}</p>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.steps.map((s, i) => (
          <li class="card p-5">
            <span class="inline-flex w-8 h-8 items-center justify-center rounded-control bg-primary text-white text-sm font-bold">{num(i + 1)}</span>
            <h3 class="mt-4 text-[17px] font-semibold text-ink">{s.title}</h3>
            <p class="mt-2 text-sm text-muted leading-relaxed">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Feature spotlights -->
  <section id="features" class="py-16 sm:py-24 bg-paper-2 border-y border-rule">
    <div class="section">
      <p class="eyebrow">{t.featuresEyebrow}</p>
      <h2 class="section-title mt-2">{t.featuresTitle}</h2>
      <p class="section-lead">{t.featuresLead}</p>

      <!-- Landing pages -->
      <div class="mt-12 grid gap-10 lg:grid-cols-2 items-center">
        <div>
          <h3 class="text-[22px] sm:text-[26px] font-bold text-ink leading-snug">{t.lp.title}</h3>
          <p class="mt-3 text-muted leading-relaxed">{t.lp.body}</p>
          <ul class="mt-5 space-y-2.5 text-[14px] text-ink-2">
            {t.lp.points.map((p) => <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />{p}</li>)}
          </ul>
        </div>
        <div class="flex justify-center" role="img" aria-label={t.lp.label}>
          <div class="w-[280px] rounded-[34px] bg-frame p-2.5 shadow-[0_24px_50px_-20px_oklch(0%_0_0/0.45)]" aria-hidden="true">
            <div class="rounded-[26px] bg-paper overflow-hidden">
              <div class="h-[150px] bg-paper-3 flex items-center justify-center text-muted"><Icon name="image" size={36} /></div>
              <div class="p-4">
                <div class="flex items-center justify-between">
                  <span class="badge badge-plain">{t.sample}</span>
                  <span class="text-[12px] text-muted line-through">{t.lp.oldPrice}</span>
                </div>
                <div class="mt-2 text-[16px] font-bold text-ink leading-snug">{t.lp.product}</div>
                <div class="text-[20px] font-bold text-primary">{t.lp.price}</div>
                <div class="mt-3 space-y-2">
                  {t.lp.fields.map((f) => <div class="field">{f}</div>)}
                  <div class="grid grid-cols-2 gap-2">
                    <div class="field !border-primary text-ink">{t.lp.inside}</div>
                    <div class="field">{t.lp.outside}</div>
                  </div>
                </div>
                <div class="mt-3 flex justify-between text-[12.5px]"><span class="text-muted">{t.lp.total}</span><span class="font-bold text-ink">{t.lp.totalValue}</span></div>
                <div class="mt-2 h-9 rounded-control bg-primary text-white text-[13px] font-semibold flex items-center justify-center" style="box-shadow: var(--shadow-btn-fill)">{t.lp.order}</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Orders -->
      <div class="mt-20 grid gap-10 lg:grid-cols-2 items-center">
        <div class="lg:order-2">
          <h3 class="text-[22px] sm:text-[26px] font-bold text-ink leading-snug">{t.orders.title}</h3>
          <p class="mt-3 text-muted leading-relaxed">{t.orders.body}</p>
          <ul class="mt-5 space-y-2.5 text-[14px] text-ink-2">
            {t.orders.points.map((p) => <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />{p}</li>)}
          </ul>
        </div>
        <div class="lg:order-1 card p-4 sm:p-5" role="img" aria-label={t.orders.label}>
          <div aria-hidden="true">
            <div class="flex items-center justify-between">
              <div class="text-[14px] font-semibold">{t.orders.status}</div>
              <span class="badge badge-plain">{t.sample}</span>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-1.5">
              {t.orders.flow.map((f, i) => (
                <Fragment>
                  {i > 0 && <Icon name="arrow" size={13} class="text-muted" />}
                  <span class={`badge ${flowCls[i]}`}>{f}</span>
                </Fragment>
              ))}
            </div>
            <div class="mt-5 rounded-card border border-rule">
              <div class="flex items-center justify-between px-4 h-11 border-b border-rule">
                <div class="text-[13px] font-semibold">{t.orders.no}</div>
                <span class="badge badge-ok">{t.orders.confirmed}</span>
              </div>
              <div class="px-4 py-3 text-[13px] space-y-2">
                <div class="flex justify-between"><span class="text-muted">{t.orders.item}</span><span>{t.orders.itemPrice}</span></div>
                <div class="flex justify-between"><span class="text-muted">{t.orders.delivery}</span><span>{t.orders.deliveryPrice}</span></div>
                <div class="flex justify-between font-semibold border-t border-rule pt-2"><span>{t.orders.collect}</span><span>{t.orders.collectValue}</span></div>
              </div>
              <div class="flex flex-wrap gap-2 px-4 pb-4">
                <span class="btn btn-sm btn-primary pointer-events-none"><Icon name="truck" size={15} /> {t.orders.book}</span>
                <span class="btn btn-sm pointer-events-none">{t.orders.packed}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Protection and incomplete orders -->
      <div class="mt-20 grid gap-10 lg:grid-cols-2 items-center">
        <div>
          <h3 class="text-[22px] sm:text-[26px] font-bold text-ink leading-snug">{t.protect.title}</h3>
          <p class="mt-3 text-muted leading-relaxed">{t.protect.body}</p>
          <ul class="mt-5 space-y-2.5 text-[14px] text-ink-2">
            {t.protect.points.map((p) => <li class="flex gap-2.5"><Icon name="check" class="text-primary shrink-0 mt-0.5" />{p}</li>)}
          </ul>
        </div>
        <div class="card overflow-hidden" role="img" aria-label={t.protect.label}>
          <div aria-hidden="true">
            <div class="flex items-center justify-between px-4 h-12 border-b border-rule">
              <div class="text-[14px] font-semibold">{t.protect.listTitle}</div>
              <span class="badge badge-plain">{t.sample}</span>
            </div>
            {t.protect.rows.map((r) => (
              <div class="flex items-center gap-3 px-4 h-14 border-b border-rule">
                <div class="min-w-0 flex-1">
                  <div class="text-[13px] font-medium text-ink truncate">{r.name}</div>
                  <div class="text-[12px] text-muted truncate">{r.item} · {r.when}</div>
                </div>
                <span class="btn btn-sm pointer-events-none"><Icon name="phone" size={14} /> {t.protect.call}</span>
              </div>
            ))}
            <div class="flex items-center gap-3 px-4 py-3 bg-error-soft">
              <Icon name="shield" class="text-error shrink-0" />
              <div class="text-[12.5px] text-ink-2">{t.protect.blocked}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- More tools -->
  <section class="py-16 sm:py-24">
    <div class="section">
      <p class="eyebrow">{t.moreEyebrow}</p>
      <h2 class="section-title mt-2">{t.moreTitle}</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {t.tools.map((tool) => (
          <div class="card p-5">
            <h3 class="text-[16px] font-semibold text-ink">{tool.title}</h3>
            <p class="mt-1.5 text-sm text-muted leading-relaxed">{tool.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Built for Bangladesh -->
  <section class="pb-16 sm:pb-24">
    <div class="section">
      <div class="rounded-panel bg-frame text-frame-ink p-6 sm:p-10 grid gap-8 lg:grid-cols-2">
        <div>
          <p class="text-[13px] font-semibold text-frame-active">{t.bd.eyebrow}</p>
          <h2 class="mt-2 text-[24px] sm:text-[32px] font-bold leading-snug">{t.bd.title}</h2>
          <p class="mt-3 text-frame-muted leading-relaxed">{t.bd.body}</p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 self-center">
          {t.bd.points.map(([title, body]) => (
            <li class="rounded-card border border-frame-rule p-4">
              <div class="flex items-center gap-2 font-semibold text-[15px]"><Icon name="check" size={16} class="text-frame-active" />{title}</div>
              <p class="mt-1.5 text-[13px] text-frame-muted leading-relaxed">{body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Coming soon -->
  <section class="pb-16 sm:pb-24">
    <div class="section">
      <p class="eyebrow">{t.soonEyebrow}</p>
      <h2 class="section-title mt-2">{t.soonTitle}</h2>
      <p class="section-lead">{t.soonLead}</p>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {t.soon.map((s) => (
          <div class="flex gap-3 rounded-card border border-dashed border-rule-strong p-4">
            <div>
              <div class="flex items-center gap-2"><h3 class="text-[15px] font-semibold text-ink">{s.title}</h3><span class="badge badge-plain">{t.soonBadge}</span></div>
              <p class="mt-1 text-[13px] text-muted">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-16 sm:py-24 bg-paper-2 border-y border-rule">
    <div class="section grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">{t.faqEyebrow}</p>
        <h2 class="section-title mt-2">{t.faqTitle}</h2>
        <p class="section-lead">{t.faqLeadA}<a href={WHATSAPP_URL} class="text-primary underline">{t.faqLeadLink}</a>{t.faqLeadB}</p>
      </div>
      <div class="lg:col-span-8 card divide-y divide-rule">
        {t.faqs.map((f) => (
          <details class="group px-5">
            <summary class="list-none [&::-webkit-details-marker]:hidden flex items-center justify-between gap-4 py-4 cursor-pointer text-[15px] font-semibold text-ink">
              {f.q}
              <span class="shrink-0 text-muted transition-transform group-open:rotate-45"><Icon name="close" size={16} class="rotate-45" /></span>
            </summary>
            <p class="pb-5 -mt-1 text-[14px] text-muted leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="py-16 sm:py-24">
    <div class="section text-center">
      <h2 class="section-title mx-auto max-w-2xl">{t.ctaTitle}</h2>
      <p class="section-lead mx-auto">{t.ctaLead}</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={SIGNUP_URL} class="btn btn-primary">{t.signup} <Icon name="arrow" size={16} /></a>
        <a href={WHATSAPP_URL} class="btn"><Icon name="message" size={16} /> {t.ctaWhatsapp}</a>
      </div>
    </div>
  </section>
</Layout>
