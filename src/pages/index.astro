      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {soon.map((s) => (
          <div class="flex gap-3 rounded-card border border-dashed border-rule-strong p-4">
            <div>
              <div class="flex items-center gap-2"><h3 class="text-[15px] font-semibold text-ink">{s.title}</h3><span class="badge badge-plain">আসছে</span></div>
