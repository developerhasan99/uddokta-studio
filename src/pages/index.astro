            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-16 sm:py-24 bg-paper-2 border-y border-rule">
    <div class="section grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow">প্রশ্ন ও উত্তর</p>
        <h2 class="section-title mt-2">সেলাররা যা সবচেয়ে বেশি জানতে চান</h2>
        <p class="section-lead">উত্তর না পেলে <a href={WHATSAPP_URL} class="text-primary underline">হোয়াটসঅ্যাপে</a> জিজ্ঞেস করুন।</p>
      </div>
      <div class="lg:col-span-8 card divide-y divide-rule">
        {faqs.map((f) => (
          <details class="group px-5">
            <summary class="list-none [&::-webkit-details-marker]:hidden flex items-center justify-between gap-4 py-4 cursor-pointer text-[15px] font-semibold text-ink">
              {f.q}
              <span class="shrink-0 text-muted transition-transform group-open:rotate-45"><Icon name="close" size={16} class="rotate-45" /></span>
            </summary>
            <p class="pb-5 -mt-1 text-[14px] text-muted leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final call to action -->
  <section class="py-16 sm:py-24">
    <div class="section text-center">
      <h2 class="section-title mx-auto max-w-2xl">আজই প্রথম ল্যান্ডিং পেজ চালু করুন</h2>
      <p class="section-lead mx-auto">অ্যাকাউন্ট খুলুন, দোকানের নাম দিন, একটি পণ্য যোগ করুন। তারপর তৈরি লেআউট থেকে প্রথম পেজ।</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={SIGNUP_URL} class="btn btn-primary">অ্যাকাউন্ট খুলুন <Icon name="arrow" size={16} /></a>
        <a href={WHATSAPP_URL} class="btn"><Icon name="message" size={16} /> হোয়াটসঅ্যাপে কথা বলুন</a>
      </div>
    </div>
  </section>
