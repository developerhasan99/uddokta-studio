---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { SIGNUP_URL, LOGIN_URL, PHONE, PHONE_TEL, WHATSAPP_URL, EMAIL, BRAND, type Lang } from "../site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = {
  bn: {
    about: "বাংলাদেশের অনলাইন সেলারদের জন্য বাংলায় বানানো কমার্স সফটওয়্যার। ল্যান্ডিং পেজ, ক্যাশ অন ডেলিভারি অর্ডার, কুরিয়ার আর লাভের হিসাব, সব এক জায়গায়।",
    features: "ফিচার", how: "কীভাবে কাজ করে", faq: "প্রশ্ন ও উত্তর", blog: "ব্লগ", login: "লগইন", signup: "অ্যাকাউন্ট খুলুন",
    contact: "যোগাযোগ", whatsapp: "হোয়াটসঅ্যাপে মেসেজ দিন", phone: PHONE,
    copyright: `© ২০২৬ ${BRAND.bn}। সব স্বত্ব সংরক্ষিত।`,
  },
  en: {
    about: "Commerce software built for online sellers in Bangladesh. Landing pages, cash-on-delivery orders, couriers and profit tracking, all in one place.",
    features: "Features", how: "How it works", faq: "FAQ", blog: "Blog", login: "Log in", signup: "Sign up",
    contact: "Contact", whatsapp: "Message us on WhatsApp", phone: "+880 1724-694718",
    copyright: `© 2026 ${BRAND.en}. All rights reserved.`,
  },
}[lang];
const home = lang === "en" ? "/en/" : "/";
---
<footer id="contact" class="bg-frame text-frame-muted">
  <div class="section py-14 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo dark lang={lang} />
      <p class="mt-4 text-sm leading-relaxed max-w-sm">{t.about}</p>
    </div>
    <div class="md:col-span-3">
      <h2 class="text-xs font-semibold text-frame-ink mb-4">{BRAND[lang]}</h2>
      <ul class="space-y-2.5 text-sm">
        <li><a href={`${home}#features`} class="hover:text-frame-ink no-underline">{t.features}</a></li>
        <li><a href={`${home}#how`} class="hover:text-frame-ink no-underline">{t.how}</a></li>
        <li><a href={`${home}#faq`} class="hover:text-frame-ink no-underline">{t.faq}</a></li>
        <li><a href="/blog" class="hover:text-frame-ink no-underline">{t.blog}</a></li>
        <li><a href={LOGIN_URL} class="hover:text-frame-ink no-underline">{t.login}</a></li>
        <li><a href={SIGNUP_URL} class="hover:text-frame-ink no-underline">{t.signup}</a></li>
      </ul>
    </div>
    <div class="md:col-span-4">
      <h2 class="text-xs font-semibold text-frame-ink mb-4">{t.contact}</h2>
      <ul class="space-y-3 text-sm">
        <li><a href={WHATSAPP_URL} class="inline-flex items-center gap-2.5 hover:text-frame-ink no-underline"><Icon name="message" size={16} /> {t.whatsapp}</a></li>
        <li><a href={`tel:${PHONE_TEL}`} class="inline-flex items-center gap-2.5 hover:text-frame-ink no-underline"><Icon name="phone" size={16} /> {t.phone}</a></li>
        <li><a href={`mailto:${EMAIL}`} class="inline-flex items-center gap-2.5 hover:text-frame-ink no-underline"><Icon name="mail" size={16} /> {EMAIL}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-frame-rule">
    <div class="section py-5 text-xs">{t.copyright}</div>
  </div>
</footer>
