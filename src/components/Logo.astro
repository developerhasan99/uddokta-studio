---
import { BRAND, type Lang } from "../site";
interface Props { dark?: boolean; lang?: Lang }
const { dark = false, lang = "bn" } = Astro.props;
---
<a href={lang === "en" ? "/en/" : "/"} class={`inline-flex items-center gap-2 font-semibold text-[17px] no-underline ${dark ? "text-frame-ink" : "text-ink"}`}>
  <img src="/favicon.svg" width="28" height="28" alt="" />
  {BRAND[lang]}
</a>
