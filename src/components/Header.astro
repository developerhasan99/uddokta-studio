---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { SIGNUP_URL, LOGIN_URL, type Lang } from "../site";

interface Props { lang: Lang; alternates: Partial<Record<Lang, string>> }
const { lang, alternates } = Astro.props;

const t = {
  bn: { features: "ফিচার", how: "কীভাবে কাজ করে", faq: "প্রশ্ন ও উত্তর", blog: "ব্লগ", login: "লগইন", signup: "অ্যাকাউন্ট খুলুন", nav: "প্রধান মেনু", mobileNav: "মোবাইল মেনু", menu: "মেনু" },
  en: { features: "Features", how: "How it works", faq: "FAQ", blog: "Blog", login: "Log in", signup: "Sign up", nav: "Main menu", mobileNav: "Mobile menu", menu: "Menu" },
}[lang];
const home = lang === "en" ? "/en/" : "/";
const links = [
  { name: t.features, href: `${home}#features` },
  { name: t.how, href: `${home}#how` },
  { name: t.faq, href: `${home}#faq` },
  { name: t.blog, href: "/blog" },
];

// Language switch: go to this page's translation, or the other language's home page.
const other: Lang = lang === "en" ? "bn" : "en";
const switchHref = alternates[other] ?? (other === "en" ? "/en/" : "/");
const switchLabel = other === "en" ? "English" : "বাংলা";
---
<header class="sticky top-0 z-50 bg-paper border-b border-rule">
  <div class="section h-16 flex items-center justify-between gap-6">
    <Logo lang={lang} />
    <nav class="hidden md:flex items-center gap-7" aria-label={t.nav}>
      {links.map((l) => <a href={l.href} class="text-sm font-medium text-ink-2 hover:text-primary no-underline">{l.name}</a>)}
    </nav>
    <div class="hidden md:flex items-center gap-2">
      <a href={switchHref} hreflang={other} lang={other} class="btn btn-sm" data-lang-switch><Icon name="globe" size={15} /> {switchLabel}</a>
      <a href={LOGIN_URL} class="btn btn-sm">{t.login}</a>
      <a href={SIGNUP_URL} class="btn btn-sm btn-primary">{t.signup}</a>
    </div>
    <details class="md:hidden group">
      <summary class="list-none btn btn-sm w-8 px-0 [&::-webkit-details-marker]:hidden" aria-label={t.menu}>
        <Icon name="menu" class="group-open:hidden" />
        <Icon name="close" class="hidden group-open:block" />
      </summary>
      <div class="absolute left-0 right-0 top-16 bg-paper border-b border-rule px-4 pb-4" style="box-shadow: var(--shadow-menu)">
        <nav class="flex flex-col py-2" aria-label={t.mobileNav}>
          {links.map((l) => <a href={l.href} class="py-2.5 text-[15px] font-medium text-ink no-underline border-b border-rule last:border-0">{l.name}</a>)}
        </nav>
        <div class="grid grid-cols-2 gap-2 pt-2">
          <a href={switchHref} hreflang={other} lang={other} class="btn btn-sm col-span-2" data-lang-switch><Icon name="globe" size={15} /> {switchLabel}</a>
          <a href={LOGIN_URL} class="btn btn-sm">{t.login}</a>
          <a href={SIGNUP_URL} class="btn btn-sm btn-primary">{t.signup}</a>
        </div>
      </div>
    </details>
  </div>
</header>
<script>
  // Close the phone menu after a link is tapped (anchor links stay on the same page).
  document.querySelectorAll("header details a").forEach((a) =>
    a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
  );
  // Keep the reader's section (#faq etc.) when switching language.
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((a) =>
    a.addEventListener("click", () => { if (location.hash) a.hash = location.hash; }),
  );
</script>
