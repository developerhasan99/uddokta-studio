---
// A drawn copy of the dashboard's Home screen. Every figure here is sample data and says so.
import Icon from "./Icon.astro";
import { BRAND, type Lang } from "../site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const points = [
  "0,18 10,15 20,16 30,10 40,12 50,6 60,4",
  "0,16 10,17 20,12 30,13 40,8 50,9 60,3",
  "0,10 10,9 20,11 30,8 40,7 50,8 60,6",
  "0,19 10,14 20,15 30,11 40,12 50,7 60,5",
];
const cls = ["badge-new", "badge-ok", "badge-warn", "badge-plain"];
const t = {
  bn: {
    label: `${BRAND.bn} ড্যাশবোর্ডের হোম পেজ, নমুনা তথ্যসহ`,
    nav: ["হোম", "অর্ডার", "পণ্য", "কাস্টমার", "ডিসকাউন্ট", "মিডিয়া", "হিসাব"],
    channelsTitle: "বিক্রির মাধ্যম", channels: ["ল্যান্ডিং পেজ", "অনলাইন স্টোর"], settings: "সেটিংস",
    title: "হোম", subtitle: "দোকান চালু করার ধাপ আর বিক্রির হিসাব।", sample: "নমুনা তথ্য",
    stats: [["আজকের অর্ডার", "২৪"], ["বিক্রি", "৳৩৮,৪৫০"], ["ডেলিভারি হার", "৮৭%"], ["লাভ", "৳১১,২০০"]],
    recent: "সাম্প্রতিক অর্ডার", all: "সব দেখুন",
    orders: [
      ["#১০৪২", "রাফিয়া সুলতানা", "কটন থ্রি-পিস", "৳১,৮৫০", "নতুন"],
      ["#১০৪১", "তানভীর আহমেদ", "লেদার ওয়ালেট", "৳৯৯০", "নিশ্চিত"],
      ["#১০৪০", "নুসরাত জাহান", "হিজাব সেট", "৳১,২৬০", "কুরিয়ারে"],
      ["#১০৩৯", "সাকিব হাসান", "স্মার্ট ওয়াচ", "৳২,৪৯০", "ডেলিভারি হয়েছে"],
    ],
  },
  en: {
    label: `${BRAND.en} dashboard home page, with sample data`,
    nav: ["Home", "Orders", "Products", "Customers", "Discounts", "Media", "Reports"],
    channelsTitle: "Sales channels", channels: ["Landing pages", "Online store"], settings: "Settings",
    title: "Home", subtitle: "Store setup steps and sales at a glance.", sample: "Sample data",
    stats: [["Today's orders", "24"], ["Sales", "৳38,450"], ["Delivery rate", "87%"], ["Profit", "৳11,200"]],
    recent: "Recent orders", all: "View all",
    orders: [
      ["#1042", "Rafia Sultana", "Cotton three-piece", "৳1,850", "New"],
      ["#1041", "Tanvir Ahmed", "Leather wallet", "৳990", "Confirmed"],
      ["#1040", "Nusrat Jahan", "Hijab set", "৳1,260", "With courier"],
      ["#1039", "Sakib Hasan", "Smart watch", "৳2,490", "Delivered"],
    ],
  },
}[lang];
const nav = ["home", "bag", "tag", "users", "ticket", "image", "chart"].map((icon, i) => ({ icon, name: t.nav[i], active: i === 0 }));
const channels = ["layout", "store"].map((icon, i) => ({ icon, name: t.channels[i] }));
const stats = t.stats.map(([label, value], i) => ({ label, value, points: points[i] }));
const orders = t.orders.map(([no, name, item, total, status], i) => ({ no, name, item, total, status, cls: cls[i] }));
---
<div class="rounded-panel bg-frame p-1.5 sm:p-2 shadow-[0_24px_60px_-20px_oklch(0%_0_0/0.45)]" role="img" aria-label={t.label}>
  <div class="flex gap-2" aria-hidden="true">
    <aside class="hidden md:flex w-[168px] shrink-0 flex-col py-2 px-1.5 text-[12.5px] text-frame-muted">
      <div class="flex items-center gap-2 px-2 pb-3 text-frame-ink font-semibold text-[14px]">
        <img src="/favicon.svg" width="20" height="20" alt="" /> {BRAND[lang]}
      </div>
      {nav.map((n) => (
        <div class={`flex items-center gap-2 h-[30px] px-2 rounded-[6px] ${n.active ? "bg-frame-3 text-frame-ink" : ""}`}>
          <Icon name={n.icon} size={15} class={n.active ? "text-frame-active" : ""} /> {n.name}
        </div>
      ))}
      <div class="px-2 pt-3 pb-1 text-[11px] text-frame-muted/70">{t.channelsTitle}</div>
      {channels.map((n) => (
        <div class="flex items-center gap-2 h-[30px] px-2"><Icon name={n.icon} size={15} /> {n.name}</div>
      ))}
      <div class="mt-auto flex items-center gap-2 h-[30px] px-2"><Icon name="settings" size={15} /> {t.settings}</div>
    </aside>

    <div class="flex-1 min-w-0 rounded-[11px] bg-paper-2 p-3 sm:p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <div class="text-[18px] sm:text-[22px] font-bold text-ink leading-tight">{t.title}</div>
          <div class="text-[12px] text-muted mt-0.5">{t.subtitle}</div>
        </div>
        <span class="badge badge-plain shrink-0">{t.sample}</span>
      </div>

      <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-3">
        {stats.map((s) => (
          <div class="card p-3">
            <div class="text-[11.5px] text-muted">{s.label}</div>
            <div class="mt-1 flex items-end justify-between gap-2">
              <div class="text-[16px] sm:text-[18px] font-bold text-ink leading-none">{s.value}</div>
              <svg width="60" height="22" viewBox="0 0 60 22" class="text-primary shrink-0">
                <polyline points={s.points} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round" />
              </svg>
            </div>
          </div>
        ))}
      </div>

      <div class="card mt-3 overflow-hidden">
        <div class="flex items-center justify-between px-3 h-10 border-b border-rule">
          <div class="text-[13px] font-semibold">{t.recent}</div>
          <div class="text-[12px] text-primary font-medium">{t.all}</div>
        </div>
        <table class="w-full text-[12px]">
          <tbody>
            {orders.map((o) => (
              <tr class="border-b border-rule last:border-0">
                <td class="px-3 h-9 font-medium text-ink whitespace-nowrap">{o.no}</td>
                <td class="px-2 text-ink-2 whitespace-nowrap">{o.name}</td>
                <td class="px-2 text-muted whitespace-nowrap hidden sm:table-cell">{o.item}</td>
                <td class="px-2 text-ink whitespace-nowrap text-right">{o.total}</td>
                <td class="px-3 text-right"><span class={`badge ${o.cls}`}>{o.status}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
