---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<Layout title="ব্লগ | উদ্যোক্তা" description="অনলাইন সেলারদের জন্য বিক্রি, ডিজাইন আর ব্যবসা চালানোর লেখা।">
  <section class="section pt-14 sm:pt-20 pb-10">
    <p class="eyebrow">ব্লগ</p>
    <h1 class="mt-2 text-[32px] sm:text-[44px] font-bold tracking-tight text-ink leading-tight">সেলারদের জন্য লেখা</h1>
    <p class="section-lead">অনলাইনে বিক্রি, পেজ ডিজাইন আর ব্যবসা চালানো নিয়ে কাজের কথা।</p>
  </section>
  <section class="section pb-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="card overflow-hidden no-underline group flex flex-col">
          <img src={post.data.image} alt="" loading="lazy" class="aspect-[16/10] w-full object-cover bg-paper-3" />
          <div class="p-5 flex flex-col flex-1">
            <div class="flex items-center gap-2 text-[12px] text-muted">
              <span class="badge badge-plain">{post.data.category}</span>
              <span>{post.data.readTime}</span>
            </div>
            <h2 class="mt-3 text-[17px] font-semibold text-ink leading-snug group-hover:text-primary">{post.data.title}</h2>
            <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-3">{post.data.description}</p>
            <p class="mt-auto pt-4 text-[12px] text-muted">{post.data.pubDate}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
