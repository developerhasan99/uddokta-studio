---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { WHATSAPP_URL, BRAND, type Lang } from "../site";

// `alternates` maps each language to this page's address in it; pages without a translation leave it out.
interface Props { title: string; description?: string; lang?: Lang; alternates?: Partial<Record<Lang, string>> }
const t = {
  bn: {
    description: "উদ্যোক্তা কমার্স: ফেসবুক আর ক্যাশ অন ডেলিভারিতে বিক্রি করা সেলারদের জন্য ল্যান্ডিং পেজ, অর্ডার, ভুয়া অর্ডার সুরক্ষা, কুরিয়ার বুকিং আর লাভের হিসাব, বাংলায়।",
    waText: "আসসালামু আলাইকুম, উদ্যোক্তা কমার্স সম্পর্কে জানতে চাই।",
    waLabel: "হোয়াটসঅ্যাপে কথা বলুন",
    waShort: "কথা বলুন",
    locale: "bn_BD",
  },
  en: {
    description: "Uddokta Commerce: landing pages, orders, fake-order protection, courier booking and profit tracking for Facebook and cash-on-delivery sellers in Bangladesh.",
    waText: "Hi, I'd like to know more about Uddokta Commerce.",
    waLabel: "Chat on WhatsApp",
    waShort: "Chat with us",
    locale: "en_US",
  },
};
const { lang = "bn", alternates = {} } = Astro.props;
const { title, description = t[lang].description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    {Object.entries(alternates).map(([l, href]) => <link rel="alternate" hreflang={l} href={new URL(href, Astro.site)} />)}
    {alternates.bn && <link rel="alternate" hreflang="x-default" href={new URL(alternates.bn, Astro.site)} />}
    <meta property="og:site_name" content={BRAND[lang]} />
    <meta property="og:locale" content={t[lang].locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0a8a55" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=Noto+Sans+Bengali:wght@400..700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={lang} alternates={alternates} />
    <main class="flex-grow"><slot /></main>
    <Footer lang={lang} />
    <a
      href={`${WHATSAPP_URL}?text=${encodeURIComponent(t[lang].waText)}`}
      target="_blank"
      rel="noopener"
      aria-label={t[lang].waLabel}
      class="fixed bottom-5 right-5 z-50 inline-flex items-center gap-2 rounded-full bg-[#25D366] text-[#111b21] border border-[#111b21] px-4 h-12 shadow-lg no-underline font-semibold text-sm hover:brightness-95"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35M12.05 21.8h-.01a9.9 9.9 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.83 9.83 0 0 1 9.89 9.89c0 5.45-4.44 9.88-9.9 9.88m8.41-18.3A11.81 11.81 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"/></svg>
      <span class="hidden sm:inline">{t[lang].waShort}</span>
    </a>
  </body>
</html>
